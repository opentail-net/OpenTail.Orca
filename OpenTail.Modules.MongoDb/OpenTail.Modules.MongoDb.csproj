<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>OpenTail.Modules.MongoDb</PackageId>
    <Description>OpenTail Host module: governed read-only MongoDB queries (collections, find, aggregate, count) over one allowed collection at a time, with an operator allow-list, resource bounds, a server-side time limit and the action id as the operation's comment. Use a login with the read role.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenTail.Host.Abstractions\OpenTail.Host.Abstractions.csproj" />
    <PackageReference Include="MongoDB.Driver" />
    <Using Include="Microsoft.Extensions.AI" />
    <Using Include="OpenTail.Host.Abstractions" />
    <Using Include="System.ComponentModel" />
    <InternalsVisibleTo Include="OpenTail.Host.Tests" />
  </ItemGroup>
</Project>
