<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>opentail-orca-email</AssemblyName>
    <Description>Sample deployment: an MCP server that reads one IMAP inbox and sends mail through SMTP, with every send queued for approval. Only the email module is included.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenTail.Orca.Admin\OpenTail.Orca.Admin.csproj" />
    <ProjectReference Include="..\OpenTail.Modules.Email\OpenTail.Modules.Email.csproj" />
    <PackageReference Include="OpenTail.Connectivity.Inbox.Imap" />
    <None Include="policy.email.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
