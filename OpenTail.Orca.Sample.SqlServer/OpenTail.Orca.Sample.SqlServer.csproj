<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>opentail-orca-sqlserver</AssemblyName>
    <Description>Sample deployment: an MCP server over one SQL Server database. Schema and SELECT queries run through a read login; INSERT, UPDATE and DELETE, when enabled, go through a separate write login and wait for a reviewer. Only the Sql module is included.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenTail.Orca.Admin\OpenTail.Orca.Admin.csproj" />
    <ProjectReference Include="..\OpenTail.Modules.Sql\OpenTail.Modules.Sql.csproj" />
    <!-- The deployment, not the Host, chooses and pins the driver; the deployment's own vulnerability audit covers it. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <None Include="policy.sqlserver*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
