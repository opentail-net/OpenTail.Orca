<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>OpenTail.Modules.Web</PackageId>
    <Description>OpenTail Host module: fetch web pages from an explicit host allow-list as readable text, with SSRF protection (no private addresses, no unchecked redirects).</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenTail.Orca.Abstractions\OpenTail.Orca.Abstractions.csproj" />
    <PackageReference Include="OpenTail.Connectivity.Web" />
    <Using Include="Microsoft.Extensions.AI" />
    <Using Include="OpenTail.Orca.Abstractions" />
    <Using Include="System.ComponentModel" />
  </ItemGroup>
</Project>
