<Project Sdk="Microsoft.NET.Sdk">
  <!-- An integration profile as a package: no code, only the profile and its spec as resources (profiles/youtube/...).
       Enable it with "Config": { "Profile": "package:OpenTail.Profiles.YouTube/youtube" } on a "Type": "openapi" module. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>OpenTail.Profiles.YouTube</PackageId>
    <Description>OpenTail integration profile for YouTube (read only), for the openapi module. Enable with "Profile": "package:OpenTail.Profiles.YouTube/youtube". See PROFILES.md.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenTail.Modules.OpenApi\OpenTail.Modules.OpenApi.csproj" />
    <EmbeddedResource Include="..\profiles\youtube\*.json" LogicalName="profiles/youtube/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
