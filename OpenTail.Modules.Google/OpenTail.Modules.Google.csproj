<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>OpenTail.Modules.Google</PackageId>
    <Description>OpenTail Host module providers: the Email and Calendar modules over Gmail and Google Calendar (OAuth with a refresh token for one account), enabled from modules.json as "email-gmail" and "calendar-google"; and "drive-google", read-only search and text of files in allowed shared drives (service account).</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenTail.Host.Abstractions\OpenTail.Host.Abstractions.csproj" />
    <ProjectReference Include="..\OpenTail.Modules.Email\OpenTail.Modules.Email.csproj" />
    <ProjectReference Include="..\OpenTail.Modules.Calendar\OpenTail.Modules.Calendar.csproj" />
    <PackageReference Include="OpenTail.Connectivity.Inbox.Gmail" />
    <PackageReference Include="Google.Apis.Drive.v3" />
    <Using Include="OpenTail.Host.Abstractions" />
    <Using Include="OpenTail.Connectivity.Files.Contracts" />
  </ItemGroup>
</Project>
