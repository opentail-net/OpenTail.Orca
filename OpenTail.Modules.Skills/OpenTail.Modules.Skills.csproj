<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>OpenTail.Modules.Skills</PackageId>
    <Description>OpenTail Host module: serves published business skills (skills.find, skills.get) from the Host's own store, and publishes a skill version by moving a label (skills.publish, an approved action).</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenTail.Orca.Abstractions\OpenTail.Orca.Abstractions.csproj" />
    <ProjectReference Include="..\OpenTail.AgentSkills\OpenTail.AgentSkills.csproj" />
    <PackageReference Include="YamlDotNet" />
    <Using Include="Microsoft.Extensions.AI" />
    <Using Include="OpenTail.AgentSkills" />
    <Using Include="OpenTail.Orca.Abstractions" />
    <Using Include="System.ComponentModel" />
  </ItemGroup>
</Project>
