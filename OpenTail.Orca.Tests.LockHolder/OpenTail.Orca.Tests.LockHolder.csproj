<Project Sdk="Microsoft.NET.Sdk">
  <!-- A second process for the skill store's cross-process lock test: it holds the store's lock file exclusively, as another Host process would. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
