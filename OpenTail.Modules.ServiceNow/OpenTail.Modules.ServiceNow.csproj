<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>OpenTail.Modules.ServiceNow</PackageId>
    <Description>OpenTail Host module: search and read ServiceNow records (incidents by default) and their journal; comment, create, update and resolve them through the Table API, in allow-listed tables only. Writes are ExternalEffect (resolve is Destructive), so a caller that read ticket text is always held for a reviewer.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenTail.Orca.Abstractions\OpenTail.Orca.Abstractions.csproj" />
    <Using Include="Microsoft.Extensions.AI" />
    <Using Include="OpenTail.Orca.Abstractions" />
    <Using Include="System.ComponentModel" />
  </ItemGroup>
</Project>
