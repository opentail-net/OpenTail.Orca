<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- opentail-connectivity's packages. GitHub Packages needs a token even to read: set GITHUB_PACKAGES_TOKEN to a token with
         read:packages (CI does this from a secret; locally, a classic personal access token, or `gh auth token` after
         `gh auth refresh -s read:packages`). -->
    <add key="opentail-net" value="https://nuget.pkg.github.com/opentail-net/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="opentail-net">
      <package pattern="OpenTail.Connectivity.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <opentail-net>
      <add key="Username" value="opentail-net" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </opentail-net>
  </packageSourceCredentials>
</configuration>