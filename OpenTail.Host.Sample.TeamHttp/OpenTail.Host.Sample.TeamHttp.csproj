<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>opentail-host-team</AssemblyName>
    <Description>Sample deployment for a small team: files and an imported API over signed-in HTTP, with an approval queue. Run it as stdio (no flags) or over HTTP (--http).</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenTail.Host.Http\OpenTail.Host.Http.csproj" />
    <ProjectReference Include="..\OpenTail.Modules.Files\OpenTail.Modules.Files.csproj" />
    <ProjectReference Include="..\OpenTail.Modules.OpenApi\OpenTail.Modules.OpenApi.csproj" />
    <None Include="policy.team.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="http.team.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="notifications.team.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
