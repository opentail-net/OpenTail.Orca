<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Versioning via MinVer — reads git tags (e.g. v1.2.3) automatically.
         Untagged builds produce 1.0.0-alpha.0.<height> so CI pre-release
         packages are always distinguishable from a release tag. -->
    <MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- Default NuGet package metadata (applied only when a project does not set its own values) -->
    <!-- Use project file name as PackageId by default; projects may set a custom PackageId if desired -->
    <PackageId Condition="'$(PackageId)'==''">$(MSBuildProjectName)</PackageId>
    <Authors Condition="'$(Authors)'==''">OpenTail</Authors>
    <Company Condition="'$(Company)'==''">OpenTail</Company>
    <Description Condition="'$(Description)'==''">$(MSBuildProjectName) component of OpenTail. Please set a more specific Description in the project file if required.</Description>
    <PackageProjectUrl Condition="'$(PackageProjectUrl)'==''">https://github.com/opentail-net/OpenTail.Orca</PackageProjectUrl>
    <RepositoryUrl Condition="'$(RepositoryUrl)'==''">https://github.com/opentail-net/OpenTail.Orca</RepositoryUrl>
    <RepositoryType Condition="'$(RepositoryType)'==''">git</RepositoryType>
    <PackageTags Condition="'$(PackageTags)'==''">opentail;ai;agent;workspace</PackageTags>
  </PropertyGroup>
  <!-- The Host packages (Host, Host.Abstractions, Host.Admin, Modules.*, Profiles.*) are versioned together by their own tag series: tag `host-v0.0.2` to release them all as 0.0.2.
 0.x until the module contract (IHostModule/IToolRegistry) is frozen. -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('OpenTail.Orca')) Or $(MSBuildProjectName.StartsWith('OpenTail.Modules.')) Or $(MSBuildProjectName.StartsWith('OpenTail.Profiles.'))">
    <MinVerTagPrefix>host-v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.0</MinVerMinimumMajorMinor>
  </PropertyGroup>
  <!-- Everything here is licensed under proprietary commercial licence (LICENSE.md): a signed commercial licence agreement with OpenTail is needed for any use.
       -->
  <PropertyGroup>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <!-- Microsoft.AspNetCore.OpenApi 10.0.9 transitively forces Microsoft.OpenApi to 2.0.0
         regardless of the Directory.Packages.props 1.6.24 pin (no CentralPackageTransitivePinningEnabled).
         Suppress only this advisory; do not disable audit-as-error repo-wide. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v5pm-xwqc-g5wc" />
  </ItemGroup>
</Project>
