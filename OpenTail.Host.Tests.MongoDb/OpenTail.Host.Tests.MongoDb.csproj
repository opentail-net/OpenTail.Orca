<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatform>true</UseMicrosoftTestingPlatform>
    <NoWarn>$(NoWarn);xUnit1051;xUnit1031</NoWarn>
    <Description>The MongoDB module against a real server. Skips unless OTAIL_MONGODB_ADMIN, OTAIL_MONGODB_READ and OTAIL_MONGODB_READ_PASSWORD are set; the mongodb workflow starts mongo:8 and sets them.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="..\OpenTail.Host\OpenTail.Host.csproj" />
    <ProjectReference Include="..\OpenTail.Modules.MongoDb\OpenTail.Modules.MongoDb.csproj" />
  </ItemGroup>
</Project>
