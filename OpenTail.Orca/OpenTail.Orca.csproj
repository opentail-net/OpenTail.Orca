<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>OpenTail.Orca</PackageId>
    <Description>OpenTail MCP Host: loads modules, applies per-tool policy (execute, queue for approval, deny), keeps a durable action queue and audit trail, and serves the result over MCP.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- The model reviewer's system prompt (section 5.1): versioned, shipped in the package, never exposed through a tool. -->
    <EmbeddedResource Include="Review\Prompts\model-reviewer.v2.txt" LogicalName="OpenTail.Orca.Review.Prompts.model-reviewer.v2.txt" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.Extensions.Tasks" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyModel" />
    <ProjectReference Include="..\OpenTail.Orca.Abstractions\OpenTail.Orca.Abstractions.csproj" />
    <Using Include="Microsoft.Extensions.AI" />
    <Using Include="OpenTail.Orca.Abstractions" />
    <Using Include="OpenTail.Core.Tools.Abstractions" />
    <InternalsVisibleTo Include="OpenTail.Orca.Tests" />
  </ItemGroup>
</Project>
