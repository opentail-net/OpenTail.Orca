<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>OpenTail.Modules.Email</PackageId>
    <Description>OpenTail Host module: read an inbox and send mail through the OpenTail connectivity contracts. Sending is a high-impact tool, so the Host queues it for approval by policy.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenTail.Orca.Abstractions\OpenTail.Orca.Abstractions.csproj" />
    <PackageReference Include="OpenTail.Connectivity.Files" />
    <Using Include="Microsoft.Extensions.AI" />
    <Using Include="OpenTail.Orca.Abstractions" />
    <Using Include="OpenTail.Connectivity.Files.Contracts" />
    <Using Include="OpenTail.Connectivity.Files.Models" />
    <Using Include="System.ComponentModel" />
  </ItemGroup>
</Project>
