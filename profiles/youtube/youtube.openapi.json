{
  "openapi": "3.0.1",
  "info": {
    "title": "YouTube Data API v3 (subset)",
    "version": "v3",
    "description": "The three read operations the youtube profile uses, written from the YouTube Data API v3 reference (Google publishes a Discovery document, not OpenAPI). Operation ids follow Google's method ids."
  },
  "servers": [ { "url": "https://www.googleapis.com/youtube/v3" } ],
  "paths": {
    "/search": {
      "get": {
        "operationId": "youtube.search.list",
        "summary": "Returns search results (videos, channels, playlists) matching the query.",
        "parameters": [
          { "name": "part", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "q", "in": "query", "schema": { "type": "string", "description": "Search terms." } },
          { "name": "type", "in": "query", "schema": { "type": "string" } },
          { "name": "order", "in": "query", "schema": { "type": "string", "enum": [ "date", "rating", "relevance", "title", "viewCount" ] } },
          { "name": "channelId", "in": "query", "schema": { "type": "string", "description": "Only results from this channel." } },
          { "name": "maxResults", "in": "query", "schema": { "type": "integer", "description": "How many results." } },
          { "name": "publishedAfter", "in": "query", "schema": { "type": "string", "description": "RFC 3339 time; only results published after it." } },
          { "name": "pageToken", "in": "query", "schema": { "type": "string" } },
          { "name": "regionCode", "in": "query", "schema": { "type": "string" } },
          { "name": "safeSearch", "in": "query", "schema": { "type": "string" } }
        ]
      }
    },
    "/videos": {
      "get": {
        "operationId": "youtube.videos.list",
        "summary": "Returns videos by id.",
        "parameters": [
          { "name": "part", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "id", "in": "query", "schema": { "type": "string", "description": "Video id." } },
          { "name": "chart", "in": "query", "schema": { "type": "string" } },
          { "name": "maxResults", "in": "query", "schema": { "type": "integer" } }
        ]
      }
    },
    "/commentThreads": {
      "get": {
        "operationId": "youtube.commentThreads.list",
        "summary": "Returns comment threads of a video.",
        "parameters": [
          { "name": "part", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "videoId", "in": "query", "schema": { "type": "string", "description": "Video id." } },
          { "name": "maxResults", "in": "query", "schema": { "type": "integer" } },
          { "name": "order", "in": "query", "schema": { "type": "string", "enum": [ "relevance", "time" ] } },
          { "name": "textFormat", "in": "query", "schema": { "type": "string" } },
          { "name": "searchTerms", "in": "query", "schema": { "type": "string" } },
          { "name": "pageToken", "in": "query", "schema": { "type": "string" } }
        ]
      }
    }
  }
}
