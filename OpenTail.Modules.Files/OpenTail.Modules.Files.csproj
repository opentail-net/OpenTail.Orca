<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>OpenTail.Modules.Files</PackageId>
    <Description>OpenTail Host module: list, read and write files inside one configured root folder. Reads PDF and Office documents as text through OpenTail.Connectivity.Files. No dependency on OpenTail.Core.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenTail.Connectivity.Files" />
    <ProjectReference Include="..\OpenTail.Orca.Abstractions\OpenTail.Orca.Abstractions.csproj" />
    <Using Include="Microsoft.Extensions.AI" />
    <Using Include="OpenTail.Orca.Abstractions" />
    <Using Include="System.ComponentModel" />
  </ItemGroup>
</Project>
