<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>OpenTail.Host.Http</PackageId>
    <Description>OpenTail Host over Streamable HTTP for a team: OAuth 2.1 resource-server sign-in (JWT) or hashed API keys, protected-resource metadata, Origin/Host checks, rate limits, and the approval page mounted behind the same sign-in.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <ProjectReference Include="..\OpenTail.Host\OpenTail.Host.csproj" />
    <ProjectReference Include="..\OpenTail.Host.Admin\OpenTail.Host.Admin.csproj" />
    <ProjectReference Include="..\OpenTail.Host.Notifications\OpenTail.Host.Notifications.csproj" />
    <Using Include="OpenTail.Host.Abstractions" />
    <InternalsVisibleTo Include="OpenTail.Host.Tests" />
  </ItemGroup>
</Project>
