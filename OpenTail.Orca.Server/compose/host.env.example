# Secrets for the Host, read from the environment. Copy to host.env (never commit it) and fill in what your configuration names.
# Config files only ever name these variables; the values live here.

# Reviewer tokens for the review page (when reviewers do not sign in with Entra): "name:token|review;name2:token2|review,admin"
# Tokens must be at least 16 characters, e.g. from:  openssl rand -base64 24
OPENTAIL_ADMIN_TOKENS=

# The Teams bot's client secret (http.json: "Teams": { "AppPasswordEnv": "TEAMS_BOT_SECRET" }).
# TEAMS_BOT_SECRET=

# Credentials your modules map in modules.json, for example:
# GITHUB_TOKEN=
