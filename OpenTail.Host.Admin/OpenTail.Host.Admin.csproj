<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>OpenTail.Host.Admin</PackageId>
    <Description>Local admin API and page for the OpenTail Host: list the approval queue, see previews, approve, reject, request changes or edit-and-approve. Loopback only, bearer-token protected.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\OpenTail.Host\OpenTail.Host.csproj" />
    <Using Include="OpenTail.Host.Abstractions" />
  </ItemGroup>
</Project>
